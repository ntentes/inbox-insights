# roborev snapshots
/.roborev/

# Planning material. Never committed. The talk plan contains the section 6.6
# scrub table, which maps real internal terms to their talk equivalents, so
# publishing it would leak exactly the vocabulary the scrub exists to remove.
/planning/

# local configuration and secrets -- never commit these
/config.R
.Renviron
.Rhistory
.RData
.Rproj.user/

# renv: the lockfile is committed and the library is restored from it. The
# library/staging paths are ignored by renv/.gitignore, which renv maintains.

# everything below is rebuilt by prep/build_all.R from the seeded generator
/data/
/board/
/artifacts/*
!/artifacts/.gitkeep

# the Linux mcp-repl that deploy.R fetches and bundles for Connect
/bin/

# quarto render output
/.quarto/
/inbox-insights.html
/inbox-insights_files/
/weekly-report.html
/weekly-report-render-test.html

# macOS
.DS_Store
