# This repository is the deployable proof of concept and nothing else: the
# report, the two apps, the code they source, and what a clone needs to build
# the data and deploy. Everything not listed below is ignored, so talk material,
# generated artifacts, local boards, credentials and deployment records stay
# out. deploy.R's shared_files() names the same code files; keep the two lists
# in step.

/*

# Project
!/.gitignore
!/.Rprofile
!/README.md
!/LICENSE
!/config.example.R
!/renv.lock
!/renv/
/renv/*
!/renv/.gitignore
!/renv/activate.R
!/renv/settings.json

# The report and how it is published
!/weekly-report.Rmd
!/weekly-report.template.html
!/deploy.R

# The apps
!/apps/
/apps/*
!/apps/chat/
!/apps/feedback/

# The code all three source
!/R/
/R/*
!/R/charts.R
!/R/chat_plots.R
!/R/config.R
!/R/connect_access.R
!/R/context_archive.R
!/R/email_preview.R
!/R/feedback.R
!/R/headline_history.R
!/R/live_report.R
!/R/live_session.R
!/R/recipes.R
!/R/report_contract.R
!/R/snapshot.R
!/R/snapshot_pin.R
!/R/theme.R
!/R/token_budget.R

# The data generator and the first-run report the feedback app starts from
!/prep/
/prep/*
!/prep/generate_data.R
!/prep/build_cohort.R
!/prep/build_initial_report.R

# The logo the email and the apps open with, and the README's picture of the email
!/images/
/images/*
!/images/chickencloud-logo.png
!/images/chickencloud-logo-inline.png
!/images/weekly-email.png

# Never, at any depth: local configuration, credentials, rsconnect deployment
# records (they carry the Connect server URL and account), and OS litter.
/config.R
/.Renviron
.Rhistory
.RData
.Rproj.user/
rsconnect/
*.dcf
manifest.json
.DS_Store
